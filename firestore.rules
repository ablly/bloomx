rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.adminRole in ['admin', 'operator', 'finance', 'reviewer', 'support']
          || request.auth.token.email == 'zqhablly@gmail.com'
          || currentUser().data.role == 'admin'
        );
    }

    function isSeller() {
      return signedIn() && (currentUser().data.role in ['seller', 'admin']);
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) && request.resource.data.uid == userId;
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();

      match /api_keys/{keyId} {
        allow read, create, update, delete: if isSelf(userId);
      }

      match /auth_logs/{logId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if isSelf(userId);
        allow update, delete: if false;
      }

      match /transactions/{transactionId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create, update: if false;
        allow delete: if isAdmin();
      }

      match /purchases/{purchaseId} {
        allow read, create, update, delete: if isSelf(userId);
      }
    }

    match /verification_codes/{codeId} {
      allow read, write: if false;
    }

    match /sellerProfiles/{sellerId} {
      allow read: if signedIn() && (isSelf(sellerId) || resource.data.status in ['verified', 'approved']);
      allow create: if isSelf(sellerId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isSelf(sellerId) && request.resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if isSelf(sellerId) || isAdmin();
    }

    match /apiOffers/{offerId} {
      allow read: if signedIn() && (resource.data.status == 'listed' || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /merchantApiSecrets/{offerId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin())
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    match /subscriptions/{subscriptionId} {
      allow read, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId;
    }

    match /apiCallRecords/{recordId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apiOfferStats/{offerId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /seller_applications/{applicationId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /products/{productId} {
        allow read: if true;
        allow create: if signedIn() && (sellerId == request.auth.uid || isAdmin());
        allow update: if signedIn() && (sellerId == request.auth.uid || isAdmin());
        allow delete: if isAdmin();
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && (isSeller() || isAdmin())
        && request.resource.data.seller_id == request.auth.uid;
      allow update: if signedIn() && ((isSeller() && resource.data.seller_id == request.auth.uid) || isAdmin());
      allow delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if signedIn() && (resource.data.buyer_id == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.buyer_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /usage_logs/{logId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /earnings/{earningId} {
      allow read: if signedIn() && (resource.data.seller_id == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /credit_packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /credit_orders/{orderId} {
      allow read: if signedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /payment_transactions/{transactionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /credit_ledger/{ledgerId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /refunds/{refundId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /webhook_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /seller_settlements/{settlementId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /automationWorkflowEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /admin_action_requests/{requestId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /payment_reconciliation_snapshots/{snapshotId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /stripe_webhook_replay_queue/{queueId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /workflow_replay_queue/{queueId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /system_config/{configId} {
      allow read, write: if isAdmin();
    }

    match /projectProgress/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /projectProgressReviews/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
