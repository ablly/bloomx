{
  "name": "BloomX - API health monitor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bloomx/api-health",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "bloomx-api-health-webhook",
      "name": "BloomX API Health Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "listed-offer-count",
              "name": "listedOfferCount",
              "value": "={{ ($json.data.listedOffers || []).length }}",
              "type": "number"
            },
            {
              "id": "failed-call-count",
              "name": "failedCallCount",
              "value": "={{ ($json.data.recentFailedCalls || []).length }}",
              "type": "number"
            },
            {
              "id": "resource-id",
              "name": "resourceId",
              "value": "={{ $json.resourceId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "normalize-api-health",
      "name": "Normalize API health",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "BloomX API Health Webhook": {
      "main": [
        [
          {
            "node": "Normalize API health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
