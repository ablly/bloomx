{
  "name": "BloomX - Seller application review",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bloomx/seller-application",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "bloomx-seller-webhook",
      "name": "BloomX Seller Application Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "event-type",
              "name": "eventType",
              "value": "={{ $json.eventType }}",
              "type": "string"
            },
            {
              "id": "seller-name",
              "name": "sellerName",
              "value": "={{ $json.data.name || $json.data.company || 'Unknown seller' }}",
              "type": "string"
            },
            {
              "id": "seller-email",
              "name": "sellerEmail",
              "value": "={{ $json.data.email || $json.data.contactEmail || '' }}",
              "type": "string"
            },
            {
              "id": "resource-id",
              "name": "resourceId",
              "value": "={{ $json.resourceId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "normalize-seller-application",
      "name": "Normalize seller application",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "BloomX Seller Application Webhook": {
      "main": [
        [
          {
            "node": "Normalize seller application",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
