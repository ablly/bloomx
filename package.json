{
  "name": "testxianyu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run copy-cf-files",
    "copy-cf-files": "node -e \"require('fs').copyFileSync('_headers','dist/_headers');require('fs').copyFileSync('_redirects','dist/_redirects')\"",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:cloudflare": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-cloudflare-pages.ps1",
    "workflow:doctor": "tsx scripts/workflow-doctor.ts",
    "test:admin-authorization": "npm --prefix functions run build && tsx --test scripts/admin-authorization.test.ts",
    "test:admin-snapshot-core": "tsx --test scripts/admin-snapshot-core.test.ts",
    "test:platform-api-key-core": "npm --prefix functions run build && tsx --test scripts/platform-api-key-core.test.ts",
    "test:payment-reconciliation": "tsx --test scripts/payment-reconciliation.test.ts",
    "test:product-listing-core": "npm --prefix functions run build && tsx --test scripts/product-listing-core.test.ts",
    "test:subscription-ledger-core": "npm --prefix functions run build && tsx --test scripts/subscription-ledger-core.test.ts",
    "test:stripe-webhook-summary": "npm --prefix functions run build && tsx --test scripts/stripe-webhook-summary.test.ts",
    "hero:remotion:render": "remotion render src/remotion/index.ts BloomXHero public/media/bloomx-worker-loop.mp4 --codec=h264 --pixel-format=yuv420p",
    "brief": "tsx scripts/project-brief.ts",
    "links": "tsx scripts/project-brief.ts links",
    "workflow-options": "tsx scripts/project-brief.ts workflows",
    "payment-plan": "tsx scripts/project-brief.ts payments",
    "admin-plan": "tsx scripts/project-brief.ts admin",
    "seller-api-plan": "tsx scripts/project-brief.ts seller-api",
    "spec:list": "openspec list",
    "spec:list:all": "openspec list --specs",
    "spec:validate": "openspec validate --all",
    "spec:validate:strict": "openspec validate --all --strict --no-interactive",
    "spec:view": "openspec view",
    "db": "tsx scripts/db-manager.ts",
    "db:stats": "tsx scripts/db-manager.ts stats",
    "db:list": "tsx scripts/db-manager.ts list",
    "db:init": "tsx scripts/init-production-data-rest.ts"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "firebase-admin": "^13.8.0",
    "postcss": "^8.5.12",
    "protobufjs": "^7.5.5",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@remotion/cli": "^4.0.454",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase": "^12.11.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.1",
    "lucide-react": "^1.7.0",
    "node-fetch": "^2.7.0",
    "playcanvas": "^2.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.1",
    "react-router-dom": "^7.13.2",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0"
  }
}
